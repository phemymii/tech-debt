# Tech Debt ignore patterns (gitignore-style)
# Also respects the project's .gitignore and .git/info/exclude.
# Built-in defaults already skip coverage, e2e, minified assets, and
# common secrets (.env*, credentials.json, *.pem, id_rsa, etc.).
# Add project-specific paths here. Use ! to re-include.

# Examples:
# src/generated/**
# **/*.generated.ts
# fixtures/**
# vendor/**
# config/private/**
# !src/critical-path.ts

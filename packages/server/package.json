{
  "name": "@tech-debt/server",
  "version": "0.1.5",
  "description": "Fastify server for tech-debt explorer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:web",
    "copy:web": "rm -rf dist/web && cp -r ../web/dist dist/web",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@tech-debt/core": "0.1.5",
    "chokidar": "^5.0.0",
    "fastify": "^5.10.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phemymii/tech-debt.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/phemymii/tech-debt#readme",
  "bugs": {
    "url": "https://github.com/phemymii/tech-debt/issues"
  },
  "engines": {
    "node": ">=18"
  }
}

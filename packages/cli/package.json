{
  "name": "tech-debt",
  "version": "0.1.0",
  "description": "Interactive technical debt explorer — map TODO, FIXME, and @deprecated comments with git blame",
  "type": "module",
  "bin": {
    "tech-debt": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "cp ../../README.md ./README.md && npm run build"
  },
  "keywords": [
    "technical-debt",
    "todo",
    "fixme",
    "deprecated",
    "git-blame",
    "codebase-explorer",
    "developer-tools",
    "tech-debt"
  ],
  "license": "MIT",
  "dependencies": {
    "@tech-debt/core": "0.1.0",
    "@tech-debt/server": "0.1.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
